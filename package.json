		"@tailwindcss/vite": "^4.3.3",
		"markdown-it-anchor": "^9.2.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource/space-grotesk": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"markdown-it": "^15.0.2"
